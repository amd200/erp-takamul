# Copy to .env.local (never committed) and fill in. Everything here is optional.

# Error monitoring (Sentry / GlitchTip). Leave empty to turn it off.
VITE_SENTRY_DSN=
# Shown next to each error, e.g. production / staging. Defaults to the Vite mode.
VITE_APP_ENV=
# Build version, e.g. a git hash or 1.4.0.
VITE_APP_RELEASE=
